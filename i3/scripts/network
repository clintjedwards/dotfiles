#!/bin/bash

# Is any ethernet port up? Docks and USB adapters add their own en* interface,
# so there can be more than one to check.
ethernet_up() {
    local state
    for state in /sys/class/net/en*/operstate; do
        [ "$(cat "$state" 2>/dev/null)" = "up" ] && return 0
    done
    return 1
}

# iwgetid prints the SSID only when wifi is actually connected. iwconfig can't
# be used for this, since it lists "ESSID:off/any" for an idle wifi card too.
SSID=$(iwgetid -r 2>/dev/null)

if [ -n "$SSID" ]; then
    # Signal strength of the connected network
    SIGNAL=$(grep "^\s*w" /proc/net/wireless | awk '{ print int($3 * 100 / 70) "%" }')

    # Output the Wi-Fi SSID and signal strength
    echo " $SSID ($SIGNAL)"
else
    # Check for Ethernet connection
    if ethernet_up; then
        echo " Ethernet"
    else
        echo " No network connection"
    fi
fi

