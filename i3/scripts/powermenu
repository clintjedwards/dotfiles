#!/usr/bin/env bash
#
# Power menu for $mod+Shift+e. Uses the same rofi theme as the app launcher.
# Anything that ends the session asks for confirmation first.

theme="$HOME/.config/rofi/launchers/type-4/style-4.rasi"

menu() {
    rofi -dmenu -i -no-custom -p "$1" -config "$theme"
}

confirm() {
    [ "$(printf 'No\nYes\n' | menu "$1?")" = "Yes" ]
}

choice="$(printf 'Lock\nSuspend\nLogout\nReboot\nShutdown\n' | menu "Power")"

case "$choice" in
    Lock) loginctl lock-session ;;
    Suspend) confirm "$choice" && systemctl suspend ;;
    Logout) confirm "$choice" && i3-msg exit ;;
    Reboot) confirm "$choice" && systemctl reboot ;;
    Shutdown) confirm "$choice" && systemctl poweroff ;;
esac
